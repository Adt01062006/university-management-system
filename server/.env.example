# Copy this file to .env and edit it. Leave DATABASE_URL out to use the built-in demo database.
# DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-long-random-text
PORT=5000

# Only needed when NODE_ENV=production (first start creates this admin):
# NODE_ENV=production
# ADMIN_EMAIL=you@gmail.com
# ADMIN_PASSWORD=at-least-8-characters
# SEED_DEMO=true   (optional: also load sample students and marks)
